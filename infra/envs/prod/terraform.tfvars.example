# 복사해서 terraform.tfvars로 쓴다(terraform.tfvars는 git에 올라가지 않는다).
alert_email = "team-alerts@example.com"

# Cloudflare 대시보드의 도메인 Overview에서 확인한다. API 토큰은 여기에 쓰지 않고 환경 변수 CLOUDFLARE_API_TOKEN으로 넘긴다.
cloudflare_zone_id    = "<영역 ID>"
cloudflare_account_id = "<계정 ID>"

# 필요하면 바꾼다.
# raw_bucket_name    = "<직접 정할 버킷 이름>" # 비우면 "<name_prefix>-raw-events-<계정 ID>"를 쓴다
# monthly_budget_usd = 50
# cloudflare_tunnel_id = "<터널 ID>" # 터널을 대시보드에서 만든 경우만 넣는다
# instance_type      = "t3.small"
