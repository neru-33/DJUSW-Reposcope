# 환경 변수 예시
# 이 파일을 복사해 .env를 만든 뒤 실제 값을 입력한다.
# 실제 비밀키나 개인정보는 .env에만 작성하고 Git에 커밋하지 않는다.

APP_ENV=development
# 배포 시 이미지 태그와 동일한 값으로 설정
APP_VERSION=unknown
API_BASE_URL=
CORS_ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DATA_PATH=./data/sample

# API PostgreSQL 연결
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reposcope
DB_USER=reposcope
DB_PASSWORD=
DB_SSLMODE=disable
# 스키마 이름. 비우면 capstone 영역은 capstone, 수집·계정 영역은 public을 쓴다.
CAPSTONE_SCHEMA=
INGEST_SCHEMA=

# AWS
AWS_REGION=ap-northeast-2

# 로컬 수집 구성(moto). 로컬에서만 쓰는 임의 값을 입력한다.
LOCAL_WEBHOOK_SECRET=
# moto에 만드는 S3 버킷, SQS 큐, SSM 경로의 접두어(<접두어>-raw-events, <접두어>-events, /<접두어>/...)
# 수집 구성에서만 쓰고, 비어 있으면 수집 구성이 시작하지 않는다.
LOCAL_NAME_PREFIX=reposcope

# GitHub App
GITHUB_APP_ID=
# 내 컴퓨터에 있는 App 비공개 키(PEM) 파일의 경로. worker에 읽기 전용으로 넣는다. 키가 없으면 비워 둔다.
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
