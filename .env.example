# 환경 변수 예시
# 이 파일을 복사해 .env를 만든 뒤 실제 값을 입력한다.
# 실제 비밀키나 개인정보는 .env에만 작성하고 Git에 커밋하지 않는다.

APP_ENV=development
# 배포 시 이미지 태그와 동일한 값으로 설정
APP_VERSION=unknown
API_BASE_URL=
DATA_PATH=./data/sample

# API PostgreSQL 연결
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reposcope
DB_USER=
DB_PASSWORD=
DB_SSLMODE=disable

# AWS
AWS_REGION=ap-northeast-2

# 로컬 수집 구성(moto). 로컬에서만 쓰는 임의 값을 입력한다.
LOCAL_WEBHOOK_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
