# 환경 변수 예시
# 이 파일을 복사해 .env를 만든 뒤 실제 값을 입력한다.
# 실제 비밀키나 개인정보는 .env에만 작성하고 Git에 커밋하지 않는다.

APP_ENV=development
API_BASE_URL=
DATA_PATH=./data/sample

# API PostgreSQL 연결 (db 프로필 사용 시)
SPRING_PROFILES_ACTIVE=db
DB_URL=jdbc:postgresql://localhost:5432/reposcope
DB_USERNAME=
DB_PASSWORD=

# AWS
AWS_REGION=ap-northeast-2

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
